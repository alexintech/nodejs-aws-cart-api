# npm-installed packages — always rebuilt inside the container via npm ci
node_modules/

# TypeScript compiler output — built inside the container during the build stage
dist/

# Incremental TypeScript build cache — not needed in the container
*.tsbuildinfo

# Version control history — irrelevant at runtime, adds size to build context
.git/
.gitignore

# Jest coverage reports — generated by npm run test:cov, not needed at runtime
coverage/

# Test files — not executed in the production container
test/

# AWS CDK infrastructure code — deployment tooling, not part of the running service
cdk/

# Local environment files with secrets — must not be baked into the image
.env
.env.*

# Local DB migration/seed scripts — not needed at runtime inside the container
db/

# Log files that may have been generated locally
*.log
npm-debug.log*

# Docker tooling itself — no need to copy these into the build context
Dockerfile
.dockerignore

# Documentation — not needed at runtime
docs/
README.md

# Editor/IDE metadata
.vscode/
.idea/
*.swp
*.swo

# macOS filesystem artifacts
.DS_Store
